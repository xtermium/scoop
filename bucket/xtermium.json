{
    "version": "0.1.0-build.47",
    "description": "Cross-platform terminal and session manager with web/file browsers and AI. Every connection you have, in one window. Written in Rust and Svelte.",
    "homepage": "https://xtermium.com",
    "license": "AGPL-3.0-or-later",
    "notes": [
        "Sessions, tabs, trusted host keys and settings live in $persist_dir (XTERMIUM_HOME),",
        "so updates and reinstalls keep them. 'scoop uninstall --purge xtermium' deletes them.",
        "Set a recovery passphrase (Settings > Security): it opens them if the keychain entry is lost."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/xtermium/xtermium/releases/download/v0.1.0-build.47/xtermium_0.1.0_x64_en-US.msi",
            "hash": "009f173d2a154dc6d1e627ccdd081d14787033033373d3ae83bfdacd9ef71b10",
            "extract_dir": "PFiles\\xtermium"
        }
    },
    "env_add_path": ".",
    "shortcuts": [
        [
            "xtermium.exe",
            "xtermium"
        ]
    ],
    "env_set": {
        "XTERMIUM_HOME": "$persist_dir"
    },
    "persist": "logs",
    "checkver": {
        "github": "https://github.com/xtermium/xtermium",
        "regex": "(?:/releases/tag/|^)v(?<version>(?<short>[\\d.]+)-build\\.\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xtermium/xtermium/releases/download/v$version/xtermium_$matchShort_x64_en-US.msi"
            }
        }
    }
}
